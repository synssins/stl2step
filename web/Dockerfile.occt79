# Variant of web/Dockerfile that builds against conda-forge OpenCASCADE 7.9
# (what the engine's CI is calibrated on) instead of Ubuntu's 7.6.3.
# Use from compose with:  dockerfile: web/Dockerfile.occt79
# ---------- stage 1: OCCT 7.9 via micromamba + build the CLI ----------
FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake patch curl ca-certificates bzip2 \
    && rm -rf /var/lib/apt/lists/*
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /usr/local bin/micromamba \
    && micromamba create -y -p /opt/occt -c conda-forge occt=7.9 \
    && micromamba clean -a -y

WORKDIR /src/stl2step
COPY CMakeLists.txt CMakePresets.json ./
COPY cmake/ cmake/
COPY include/ include/
COPY src/ src/
COPY web/occt-link.patch /src/
RUN patch -p1 < /src/occt-link.patch \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DSTL2STEP_BUILD_TESTS=OFF \
          -DCMAKE_PREFIX_PATH=/opt/occt \
    && cmake --build build -j"$(nproc)" \
    && strip build/stl2step

# ---------- stage 2: runtime ----------
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -d /app -s /usr/sbin/nologin app

COPY --from=builder /opt/occt/lib /opt/occt/lib
COPY --from=builder /src/stl2step/build/stl2step /usr/local/bin/stl2step
COPY web/app/requirements.txt /app/requirements.txt
RUN pip3 install --break-system-packages -r /app/requirements.txt
COPY web/app/ /app/
COPY web/entrypoint.sh /entrypoint.sh
RUN mkdir -p /data && chown -R app:app /app /data && chmod +x /entrypoint.sh \
    && LD_LIBRARY_PATH=/opt/occt/lib /usr/local/bin/stl2step --version

WORKDIR /app
ENV STL2STEP_BIN=/usr/local/bin/stl2step \
    LD_LIBRARY_PATH=/opt/occt/lib \
    DATA_DIR=/data \
    MAX_UPLOAD_MB=200 \
    JOB_TIMEOUT_SEC=600 \
    CONCURRENCY=1 \
    RETAIN_DAYS=30
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/api/health').status==200 else 1)"
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
